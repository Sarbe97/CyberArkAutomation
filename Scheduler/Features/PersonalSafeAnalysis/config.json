{
  "Features": {
    "PersonalSafeAnalysis": {
      "Enabled": true,
      "ForceRefresh": false,
      "_Comment_Mode": "Supported values: Analysis",
      "Mode": "Analysis",

      "Cleanup": {
        "Enabled": true,
        "RetentionDays": 30
      },

      "SharePoint": {
        "Enabled": true,
        "FileName": "CyberArk_DailyReport.xlsx",
        "SheetName": "PersonalSafeAnalysis",
        "FolderPath": "Project Deliverables/CyberArk_Wipro/Migration"
      },

      "PersonalSafe": {
        "NamingPatternRegex": "^S-A-PR-WI-U\\d{6}$",
        "_Comment_Extraction": "Regex capture group used to extract the primary owner's username from the safe name",
        "OwnerExtractionRegex": "^S-A-PR-WI-(U\\d{6})$",
        "IgnoredMembers": [ "PasswordManager", "VaultInternal", "Administrator", "Master", "System", "Notification Engine", "Auditor", "Batch" ],
        "Members": [
          {
            "Name": "CyberArk Admins",
            "Type": "Group",
            "MemberSource": "Vault",
            "PermissionSet": "VAULT_ADMIN"
          },
          {
            "Name": "{PrimaryAccount}",
            "Type": "User",
            "MemberSource": "Domain",
            "PermissionSet": "USER_ACCESS"
          }
        ]
      },

      "_Comment_SafePermissionSets": "Defines valid permission sets to check against the safe members.",
      "SafePermissionSets": {
        "VAULT_ADMIN": [
          "ManageSafe",
          "ManageSafeMembers",
          "BackupSafe",
          "ViewAuditLog",
          "ViewSafeMembers",
          "AccessWithoutConfirmation",
          "UnlockAccounts",
          "MoveAccountsAndFolders"
        ],
        "USER_ACCESS": [
          "UseAccounts",
          "ListAccounts",
          "RetrieveAccounts",
          "InitiateCPMAccountManagementOperations"
        ]
      },

      "PrimaryAccount": {
        "Pattern": "^U\\d{6}$",
        "EmployeeNumberCapture": "^U(\\d{6})$"
      },

      "Domains": [
        {
          "Name": "NA",
          "FQDN": "na.company.com",
          "Server": "na-dc.company.com",
          "IsPrimary": true,
          "Username": "",
          "Password": "",
          "CCP": {
            "AppId": "CyberArkHealthCheck",
            "Safe": "PAM-AD-NA",
            "Object": "AD-NA-ScanAccount"
          }
        }
      ],

      "Exclusions": {
        "InbuiltSafes": [
          "System",
          "VaultInternal",
          "Notification Engine",
          "PasswordManager",
          "PasswordManager_workspace",
          "PasswordManagerShared",
          "PVWAConfig"
        ],
        "ExceptionSafes": []
      },

      "Notifications": {
        "AdminFrom": "",
        "AdminTo": [ "pam-admins@company.com" ],
        "AdminCC": []
      }
    }
  }
}

