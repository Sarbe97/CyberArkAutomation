{
    "BaseUrl": "https://vault.company.com",
    "CCP": {
        "Url": "https://ccp.company.com/AIMWebService/api/Accounts",
        "AppId": "CyberArkHealthCheck",
        "Safe": "PAM-Health",
        "Object": "SchedulerServiceAccount"
    },
    "Email": {
        "SmtpServer": "smtp.company.com",
        "From": "cyberark-alerts@company.com",
        "To": [
            "pam-ops@company.com"
        ]
    },
    "Schedules": [
        {
            "Group": "Monitoring",
            "Frequency": "Hourly",
            "Scripts": [
                "SystemHealth.ps1"
            ]
        },
        {
            "Group": "Reporting",
            "Frequency": "Daily",
            "Hour": 1,
            "Scripts": [
                "DashboardReport.ps1",
                "LDAPUserAnalysis.ps1"
            ]
        }
    ],
    "Features": {
        "SystemHealth": {
            "Enabled": true
        },
        "LDAPUserAnalysis": {
            "Enabled": true,
            "PersonalSafePattern": "[A-Za-z]\\d{6}$",
            "Domains": [
                {
                    "Name": "NA",
                    "FQDN": "na.company.com"
                },
                {
                    "Name": "NADEV",
                    "FQDN": "nadev.company.com"
                },
                {
                    "Name": "CAP",
                    "FQDN": "cap.company.com"
                },
                {
                    "Name": "NI",
                    "FQDN": "ni.company.com"
                }
            ],
            "Exclusions": {
                "Domains": [
                    "NA"
                ],
                "UsernamePatterns": [
                    "^U\\d{6}$"
                ],
                "UsernameDomainCombos": []
            }
        },
        "DashboardReport": {
            "Enabled": true,
            "MigratedSafeKeywords": ["wi", "UX"],
            "PersonalSafePattern": "^S-P-U\\d+$",
            "MigratedPlatformKeywords": ["mig_", "custom_"],
            "InbuiltSafes": ["System", "Vault", "Backup", "Notification", "AppInternal"],
            "FailedAccountExcludePlatforms": ["WinServerLocal", "UnixSSH"],
            "Domains": ["na", "nadev", "cap", "ni"]
        }
    }
}