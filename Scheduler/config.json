{
    "BaseUrl": "https://vault.company.com",
    "CCP": {
        "Url": "http://ccp.company.com/AIMWebService/api/Accounts",
        "AppId": "CyberArkHealthCheck",
        "Safe": "PAM-Health"
    },
    "Email": {
        "SmtpServer": "smtp.company.com",
        "From": "cyberark-alerts@company.com",
        "To": [
            "pam-ops@company.com"
        ]
    },
    "Features": {
        "SystemHealth": {
            "Enabled": true
        },
        "LDAPUserAnalysis": {
            "Enabled": true,
            "PersonalSafePattern": "[A-Za-z]\\d{6}$",
            "Domains": [
                {
                    "Name": "NA",
                    "FQDN": "na.company.com"
                },
                {
                    "Name": "NADEV",
                    "FQDN": "nadev.company.com"
                },
                {
                    "Name": "CAP",
                    "FQDN": "cap.company.com"
                },
                {
                    "Name": "NI",
                    "FQDN": "ni.company.com"
                }
            ],
            "Exclusions": {
                "Domains": [
                    "NA"
                ],
                "UsernamePatterns": [
                    "^U\\d{6}$"
                ],
                "UsernameDomainCombos": []
            }
        }
    }
}