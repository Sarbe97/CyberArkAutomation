      {
        "Name": "1st Shift",
        "ScheduledTime": "11:30",
        "Start": "03:30",
        "End": "15:30"
      },
      {
        "Name": "2nd Shift",
        "ScheduledTime": "19:30",
        "Start": "15:30",
        "End": "03:30"
      }
    ]
  },
